# ==============================================================================
# 1. Discord Bot & Live Monitor Channels
# ==============================================================================
DISCORD_TOKEN=
# カンマ区切りで自動反応するテキストチャンネルID・フォーラムチャンネルIDを指定
DISCORD_CHANNEL_IDS=
# 稼働状況ダッシュボードBoxを表示するチャンネルID
DISCORD_STATUS_CHANNEL_ID=
STATUS_UPDATE_INTERVAL_SEC=10
# リアルタイム生思考・ツール実行ストリームBoxを表示するチャンネルID
DISCORD_RAW_LOG_CHANNEL_ID=

# ==============================================================================
# 2. Ollama Server, Streaming & Context Budgets
# ==============================================================================
OLLAMA_BASE_URL=http://localip:11434
LLM_TIMEOUT=2400
OLLAMA_NUM_PARALLEL=1
STREAM_GRANULARITY_TOKENS=1
IO_CHUNK_BYTES=65536

# Python側のメッセージ履歴・ファイル読み込み文字数上限
CTX_CHAR_BUDGET_LIGHT=120000
CTX_CHAR_BUDGET_HEAVY=260000

# エージェントのWebサーチ機能
WEB_SEARCH_ENABLE=False

# ==============================================================================
# 3. Light Models (Main / Scout & Operator: Gemma4)
# ==============================================================================
# 未指定の役職は MODEL_MAIN にフォールバック
MODEL_MAIN=
MODEL_PM=
MODEL_SE=
MODEL_PG=
MODEL_QA=
MODEL_AUDITOR=

# Thinking Mode: true / false / high / medium / low / max
OLLAMA_THINK=true
# プロンプト側からも簡潔な思考ルールを強制するかのフラグ (True / False)
THINK_PROMPT_BOOST=False
# 軽量モデルをメモリ(VRAM/RAM)に常駐させる時間 (例: 24h, -1 で無期限常駐)
OLLAMA_KEEP_ALIVE=24h

# Generation & Hardware Options (空欄はOllamaデフォルト)
SERVER_CTX_SIZE=16384
MAX_TOKEN=8192
LLM_TEMP=1.0
LLM_TOP_P=0.95
LLM_TOP_K=64
LLM_MIN_P=0.0
LLM_REPEAT_PENALTY=1.15
LLM_REPEAT_LAST_N=256
LLM_PRESENCE_PENALTY=
LLM_FREQ_PENALTY=
LLM_SEED=
OLLAMA_NUM_GPU=
OLLAMA_NUM_THREAD=8
OLLAMA_NUM_BATCH=512

# ==============================================================================
# 4. Professional / Heavy Models (Outsourced Sub-Agent: Qwen3-Coder-Next)
# ==============================================================================
# 未指定の役職は MODEL_HEAVY にフォールバック
MODEL_HEAVY=
MODEL_HEAVY_SE=
MODEL_HEAVY_PG=

# 1回の子タスク外注 (invoke_professional) で自律実行できる最大ステップ数
PROFESSIONAL_MAX_STEPS=512

HEAVY_CTX_SIZE=32768
HEAVY_MAX_TOKEN=16384
HEAVY_THINK=true
# サブタスク連続ステップ中の再ロードを防ぐため 30m 等の指定を推奨 (完了時は自動アンロード)
HEAVY_KEEP_ALIVE=30m
HEAVY_TEMP=0.7
HEAVY_TOP_P=0.95
HEAVY_TOP_K=64
HEAVY_MIN_P=0.0
HEAVY_REPEAT_PENALTY=1.0
HEAVY_REPEAT_LAST_N=64
HEAVY_PRESENCE_PENALTY=
HEAVY_FREQ_PENALTY=
HEAVY_SEED=
HEAVY_NUM_GPU=
HEAVY_NUM_THREAD=8
HEAVY_NUM_BATCH=512

# ==============================================================================
# 5. Pipeline Loop Limits & Autonomous Initiative Mode
# ==============================================================================
MAX_STEPS_PER_PHASE=1024
PIPELINE_IDLE_SEC=10
AUDITOR_INTERVAL_SEC=21600

# 未処理タスク0件時の自律整理整頓・自己タスク起票設定
AUTONOMOUS_ENABLE=True
AUTONOMOUS_IDLE_SEC=60
AUTONOMOUS_MAX_STEPS=15

# ==============================================================================
# 6. Docker Sandbox & Workspace Directories
# ==============================================================================
DOCKER_IMAGE=sier-sandbox:latest
DOCKER_MEM_LIMIT=4g
COMMAND_TIMEOUT=300
WORKSPACE_DIR=./workspace
EXPORTS_DIR=./exports
LOG_DIR=./logs

# 起動時にworkspace内を初期化するかのフラグ (True / False)
RESET_WORKSPACE_ON_STARTUP=False
# SE/PG/QA に通知するコンテナ内導入済みツールのヒント (任意)
SANDBOX_ENV_HINT=

# ==============================================================================
# 7. Hardware Telemetry & Workspace NAS (WebUI / WebDAV / Samba)
# ==============================================================================
DESKTOP_VRAM_GB=16.0
DESKTOP_RAM_GB=64.0
# Ubuntu Server 側で動かす desktop_metrics_server.py のURL (未設定時は /api/ps にフォールバック)
DESKTOP_METRICS_URL=http://localip:11435/metrics

NAS_ENABLE=False
NAS_PORT=
NAS_USER=
NAS_PASSWORD=
SAMBA_ENABLE=False
SAMBA_PORT=